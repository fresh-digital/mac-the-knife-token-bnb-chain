{
  "name": "mac-the-knife-token",
  "version": "0.1.0",
  "description": "Mac the Knife (KNIFE) — an open-book, self-disarming fair-launch BEP-20 on BNB Chain.",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint \"contracts/**/*.sol\"",
    "check:release-files": "node scripts/check-release-files.js",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "release:check": "npm run compile && npm test && npm run lint && npm run check:release-files && npm run coverage && npm run audit:production && hardhat clean && hardhat compile",
    "rehearse": "node scripts/rehearse.js",
    "preflight:testnet": "hardhat run scripts/preflight.js --network bscTestnet",
    "preflight:mainnet": "hardhat run scripts/preflight.js --network bsc",
    "preflight:mainnet:backup": "hardhat run scripts/preflight.js --network bscBackup",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "launch:mainnet": "hardhat run scripts/open-book-launch.js --network bsc",
    "launch:mainnet:backup": "hardhat run scripts/open-book-launch.js --network bscBackup",
    "inspect:launch:mainnet": "hardhat run scripts/inspect-launch.js --network bsc",
    "inspect:launch:mainnet:backup": "hardhat run scripts/inspect-launch.js --network bscBackup",
    "verify:testnet": "hardhat verify --network bscTestnet",
    "verify:mainnet": "hardhat verify --network bsc",
    "deploy:testnet:backup": "hardhat run scripts/deploy.js --network bscTestnetBackup",
    "verify:testnet:backup": "hardhat verify --network bscTestnetBackup",
    "verify:mainnet:backup": "hardhat verify --network bscBackup"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.17",
    "solhint": "^6.2.3",
    "solidity-coverage": "^0.8.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
