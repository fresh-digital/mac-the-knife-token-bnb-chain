# Copy this file to a new file named  .env  and fill in the blanks.
# NEVER commit the real .env (it's already in .gitignore).
# `npm test` needs NONE of this — these are only for deploying/verifying on a live network.

# 1) Deployer private key. Use a BRAND-NEW burner wallet made only for this launch,
#    funded with a little BNB for gas. Never your main wallet — this key sits in a plain file.
#    Paste it WITH or without the leading 0x, either works.
PRIVATE_KEY=

# 2) BscScan API key for source verification: https://bscscan.com/myapikey
#    (A unified Etherscan key from https://etherscan.io/myapikey also works on BSC.)
BSCSCAN_API_KEY=

# 3) Optional RPC overrides. The defaults below are reliable public nodes — only fill these
#    in if a default is slow. Alternatives:
#      testnet: https://bsc-testnet.publicnode.com  |  https://data-seed-prebsc-1-s1.bnbchain.org:8545
#      mainnet: https://bsc-dataseed1.defibit.io    |  https://bsc.publicnode.com
BSC_TESTNET_RPC_URL=
BSC_RPC_URL=
