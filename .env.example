# Copy this file to a new file named  .env  and fill in the blanks.
# NEVER commit the real .env (it's already in .gitignore).
# `npm test` needs NONE of this — these are only for deploying/verifying on a live network.

# 1) Deployer private key. Use a BRAND-NEW burner wallet made only for this launch,
#    funded with a little BNB for gas. Never your main wallet — this key sits in a plain file.
#    Paste it WITH or without the leading 0x, either works.
PRIVATE_KEY=

# 2) Optional API key for an additional Etherscan/BscScan submission. Sourcify
#    verification is enabled by default and needs no account or API key.
#    If you use one, it must be a UNIFIED ETHERSCAN key:
#      https://etherscan.io/myapikey
#    One key covers BSC via the Etherscan v2 API. BSC access may require a paid
#    Etherscan plan; leave this blank if you only want the no-key Sourcify path.
BSCSCAN_API_KEY=

# 3) Mainnet safety latch. Set this exact phrase only after `npm run
#    preflight:mainnet` prints the frozen Open Book profile and you have reviewed
#    DEPLOYMENT.md. The mainnet launch script refuses to send any transaction without it.
CONFIRM_OPEN_BOOK_LAUNCH=

# 4) Optional RPC overrides. The defaults are reliable public nodes — only fill these in if
#    a default is slow. Alternatives:
#      testnet: https://bsc-testnet-dataseed.bnbchain.org
#      mainnet: https://bsc-dataseed.defibit.io
BSC_TESTNET_RPC_URL=
BSC_RPC_URL=

# Optional fork-only endpoint. `npm run rehearse` defaults to PublicNode and pins a
# near-tip block automatically; set this only if that provider is unavailable.
BSC_FORK_RPC_URL=

# 5) Optional backup RPCs, used by the `bscTestnetBackup` / `bscBackup` networks. Same
#    chains, different operators — if a public node rate-limits or stalls mid-launch, re-run
#    the command with `--network bscBackup`. Leave blank to use the built-in defaults.
#    NOTE: this is RPC resilience only. BscScan/Etherscan API rate limits are a separate
#    service and are not affected by which RPC you use.
BSC_TESTNET_RPC_URL_BACKUP=
BSC_RPC_URL_BACKUP=
